# =========================================
# AI / ML EXAMPLE
# =========================================

print("\n===== AI/ML Example =====")

confidence_scores = ["0.95", "0.87", "invalid", "0.91"]

for score in confidence_scores:

    try:
        confidence = float(score)

        if confidence >= 0.90:
            print(f"Prediction accepted: {confidence}")

        else:
            print(f"Prediction needs review: {confidence}")

    except ValueError:
        print(f"Invalid confidence score: {score}")


# =========================================
# REPSPEED EXAMPLE
# =========================================

print("\n===== RepSpeed Example =====")

workout_data = [
    {"exercise": "Squat", "reps": "15"},
    {"exercise": "Push-up", "reps": "20"},
    {"exercise": "Lunge", "reps": "invalid"},
]

for workout in workout_data:

    try:
        reps = int(workout["reps"])

        print(
            f"{workout['exercise']}: "
            f"{reps} reps"
        )

    except ValueError:
        print(
            f"{workout['exercise']}: "
            "Invalid repetition data"
        )


# =========================================
# IMPORTANT CONCEPTS
# =========================================

"""
Remember:

try
→ Code that might cause an error.

except
→ Runs when a specific error occurs.

else
→ Runs when NO error occurs.

finally
→ Runs whether an error occurs or not.


Common exceptions:

ValueError
→ Correct type, invalid value.

Example:
int("hello")


TypeError
→ Operation performed on incompatible types.

Example:
"Python" + 10


ZeroDivisionError
→ Division by zero.

Example:
10 / 0


IndexError
→ Index does not exist.

Example:
numbers[10]


FileNotFoundError
→ Requested file does not exist.


IMPORTANT:

Exception handling is especially useful
when working with real-world datasets because
data can contain:

→ Missing values
→ Incorrect formats
→ Invalid numbers
→ Unexpected input
→ Missing files
"""



"""
=========================================
Day 03 - Python Loops


Goal:
Understand how loops automate repetitive
tasks and process collections of data.

Topics Covered:
✓ for loop
✓ range()
✓ range(start, stop, step)
✓ while loop
✓ break
✓ continue
✓ Looping through lists
✓ Looping through strings
✓ Nested loops
✓ AI/ML example
=========================================
"""


# =========================================
# FOR LOOP
# =========================================

print("===== For Loop =====")

workout = [10, 12, 15, 11, 14]

for reps in workout:
    print(f"Workout completed: {reps} reps")


# =========================================
# RANGE()
# =========================================

print("\n===== range() =====")

for i in range(5):
    print(i)


# =========================================
# RANGE(START, STOP)
# =========================================

print("\n===== range(start, stop) =====")

for i in range(2, 6):
    print(i)


# =========================================
# RANGE(START, STOP, STEP)
# =========================================

print("\n===== range(start, stop, step) =====")

for i in range(2, 10, 2):
    print(i)


# =========================================
# COUNTDOWN USING NEGATIVE STEP
# =========================================

print("\n===== Negative Step =====")

for i in range(5, 0, -1):
    print(i)


# =========================================
# LOOP THROUGH STRINGS
# =========================================

print("\n===== Loop Through a String =====")

word = "Python"

for letter in word:
    print(letter)


# =========================================
# LOOP THROUGH A LIST
# =========================================

print("\n===== Loop Through Exercises =====")

exercises = ["Push-up", "Squat", "Lunge", "Plank"]

for exercise in exercises:
    print(exercise)


# =========================================
# WHILE LOOP
# =========================================

print("\n===== While Loop =====")

count = 1

while count <= 5:
    print(count)
    count += 1


# =========================================
# BREAK
# =========================================

print("\n===== break =====")

for number in range(1, 11):

    if number == 6:
        break

    print(number)


# =========================================
# CONTINUE
# =========================================

print("\n===== continue =====")

for number in range(1, 6):

    if number == 3:
        continue

    print(number)


# =========================================
# NESTED LOOPS
# =========================================

print("\n===== Nested Loops =====")

for exercise in exercises:

    for set_number in range(1, 3):

        print(exercise, "Set", set_number)


# =========================================
# CALCULATING TOTAL REPS
# =========================================

print("\n===== Total Reps =====")

reps = [10, 15, 12, 20, 18]

total = 0

for value in reps:
    total += value

print("Total Reps:", total)


# =========================================
# FINDING EVEN NUMBERS
# =========================================

print("\n===== Even Numbers =====")

for number in range(1, 11):

    if number % 2 == 0:
        print(number)


# =========================================
# AI / ML EXAMPLE
# =========================================

print("\n===== AI/ML Example =====")

confidence_scores = [0.91, 0.87, 0.95, 0.82, 0.94]

for confidence in confidence_scores:

    if confidence >= 0.90:
        print(f"Prediction accepted: {confidence}")
    else:
        print(f"Prediction needs review: {confidence}")


# =========================================
# IMPORTANT LOOP CONCEPT
# =========================================

"""
Remember:

range(5)
→ 0, 1, 2, 3, 4

The stop value is NOT included.

range(2, 10, 2)
→ 2, 4, 6, 8

range(5, 0, -1)
→ 5, 4, 3, 2, 1
"""


